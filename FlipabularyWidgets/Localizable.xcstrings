    "Today's new-card limit is reached. The remaining new cards stay in your library." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tageslimit für neue Karten ist erreicht. Die übrigen neuen Karten bleiben in deiner Bibliothek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alcanzó el límite de tarjetas nuevas de hoy. Las tarjetas nuevas restantes se quedan en tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite de nouvelles cartes du jour est atteinte. Les autres nouvelles cartes restent dans votre bibliothèque."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batas kartu baru hari ini telah tercapai. Sisa kartu baru tetap di pustaka Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il limite di nuove carte di oggi è raggiunto. Le nuove carte rimanenti restano nella tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の新規カード上限に達しました。残りの新規カードはライブラリに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 새 카드 한도에 도달했습니다. 남은 새 카드는 보관함에 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De daglimiet voor nieuwe kaarten is bereikt. De resterende nieuwe kaarten blijven in je bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osiągnięto dzisiejszy limit nowych kart. Pozostałe nowe karty pozostają w bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O limite de novos cartões de hoje foi atingido. Os demais cartões novos ficam na sua biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дневной лимит новых карточек исчерпан. Остальные новые карточки остаются в вашей библиотеке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
