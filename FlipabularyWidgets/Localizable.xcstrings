    "Other cards are finished. The next repeat becomes available shortly." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Karten sind fertig. Die nächste Wiederholung ist bald verfügbar."
