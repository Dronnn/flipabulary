    "Repeat on any Home Screen page. Every widget can use a different word set." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole dies auf jeder Seite des Home-Bildschirms. Jedes Widget kann ein anderes Wörterset verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite el proceso en cualquier página de la Pantalla de inicio. Cada widget puede usar un conjunto de palabras diferente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répétez l'opération sur n'importe quelle page de l'écran d'accueil. Chaque widget peut utiliser un ensemble de mots différent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulangi di halaman Layar Utama mana pun. Setiap widget dapat menggunakan set kata yang berbeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripeti su qualsiasi pagina della Schermata Home. Ogni widget può usare un set di parole diverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのホーム画面ページでも同じ操作を繰り返せます。ウィジェットごとに異なる単語セットを使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 홈 화면 페이지에서 반복하십시오. 각 위젯은 서로 다른 단어 세트를 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhaal dit op elke pagina van het Beginscherm. Elke widget kan een andere woordenset gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powtórz to na dowolnej stronie ekranu początkowego. Każdy widget może używać innego zbioru słów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repita em qualquer página da Tela de Início. Cada widget pode usar um conjunto de palavras diferente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторите это на любой странице экрана «Домой». В каждом виджете может быть своя подборка слов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu istediğiniz Ana Ekran sayfasında tekrarlayın. Her widget farklı bir kelime seti kullanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторіть це на будь-якій сторінці початкового екрана. Кожен віджет може використовувати іншу добірку слів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lặp lại trên bất kỳ trang Màn hình chính nào. Mỗi tiện ích có thể dùng một bộ từ khác nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在任何主屏幕页面上重复此操作。每个小组件都可以使用不同的单词集。"
          }
        }
      }
    },
