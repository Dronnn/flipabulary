    "Steps must be positive, unique, and increasing." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritte müssen positiv, eindeutig und aufsteigend sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pasos deben ser positivos, únicos y crecientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étapes doivent être positives, uniques et croissantes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah harus positif, unik, dan bertambah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I passaggi devono essere positivi, unici e crescenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステップは正の値で、重複せず、増加している必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단계는 양수여야 하며, 중복되지 않고 증가해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stappen moeten positief, uniek en oplopend zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etapy muszą być dodatnie, unikalne i rosnące."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As etapas devem ser positivas, únicas e crescentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
