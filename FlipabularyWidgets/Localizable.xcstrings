    "Flipabulary could not open its local library. Restart the app after freeing some storage." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipabulary konnte die lokale Bibliothek nicht öffnen. Starte die App neu, nachdem du etwas Speicher freigegeben hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipabulary no pudo abrir su biblioteca local. Reinicia la app después de liberar algo de espacio."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipabulary tidak dapat membuka pustaka lokalnya. Mulai ulang aplikasi setelah mengosongkan sebagian penyimpanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipabulary non è riuscita ad aprire la libreria locale. Riavvia l'app dopo aver liberato spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipabularyはローカルライブラリを開けませんでした。空き容量を増やしてからアプリを再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipabulary가 로컬 보관함을 열 수 없습니다. 저장 공간을 확보한 후 앱을 다시 시작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
