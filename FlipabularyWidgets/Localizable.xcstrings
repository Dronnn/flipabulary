    "A Learned word returns to Learning below this repeat count." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gelerntes Wort wechselt unter dieser Wiederholungszahl zurück zu Lernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una palabra aprendida vuelve a Aprendiendo por debajo de este número de repeticiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mot appris revient en apprentissage sous ce nombre de répétitions."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata yang dikuasai kembali ke Dipelajari saat pengulangannya di bawah jumlah ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parola Imparata torna In apprendimento sotto questo numero di ripetizioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学習済みの単語は、繰り返し回数がこれを下回ると学習中に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "학습 완료 단어는 반복 횟수가 이보다 적으면 학습 중으로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een Geleerd woord gaat terug naar Leren onder dit aantal herhalingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opanowane słowo wraca do nauki, gdy liczba powtórek spadnie poniżej tej wartości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma palavra aprendida volta a aprendendo quando as repetições ficam abaixo deste valor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выученное слово возвращается в изучение, когда повторов меньше этого значения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğrenildi durumundaki bir kelime bu tekrar sayısının altına düşünce Öğreniliyor'a döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вивчене слово повертається до вивчення, коли повторів менше цього значення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ Đã học quay lại Đang học khi dưới số lần lặp này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已学会的单词在重复次数低于此值时会回到学习中。"
          }
        }
      }
    },
    "A Learned word returns to Learning when fewer than %lld repeats remain." : {
