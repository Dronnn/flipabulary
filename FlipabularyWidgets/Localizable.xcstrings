    "Entry counts are fixed by the Home Screen size. Larger text may show fewer rows so labels stay legible." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anzahl der Einträge hängt von der Größe des Home-Bildschirms ab. Größerer Text zeigt eventuell weniger Zeilen, damit Beschriftungen lesbar bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El número de entradas depende del tamaño del widget de pantalla de inicio. Un texto más grande puede mostrar menos filas para que las etiquetas sigan siendo legibles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah entri ditentukan oleh ukuran Layar Utama. Teks yang lebih besar dapat menampilkan lebih sedikit baris agar label tetap terbaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il numero di voci è fissato dalla dimensione della Schermata Home. Testi più grandi possono mostrare meno righe per mantenere leggibili le etichette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目数はホーム画面のサイズで決まります。文字が大きいと、ラベルを読みやすく保つため表示される行が少なくなることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목 수는 홈 화면 크기에 따라 고정됩니다. 글자가 크면 라벨을 읽기 쉽게 유지하기 위해 표시되는 행이 줄어들 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het aantal items wordt bepaald door de grootte van het beginscherm. Bij grotere tekst worden mogelijk minder rijen getoond zodat labels leesbaar blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba wpisów zależy od rozmiaru ekranu początkowego. Większy tekst może oznaczać mniej wierszy, aby etykiety pozostały czytelne."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğe sayısı Ana Ekran boyutuna göre sabittir. Daha büyük metin, etiketler okunaklı kalsın diye daha az satır gösterebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số mục được cố định theo kích thước Màn hình chính. Chữ lớn hơn có thể hiện ít hàng hơn để nhãn vẫn dễ đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条目数量由主屏幕尺寸决定。文字较大时可能显示更少行，以确保标签清晰可读。"
          }
        }
      }
    },
