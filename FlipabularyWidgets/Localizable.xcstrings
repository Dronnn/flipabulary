          }
        }
      }
    },
    "Good moves through the learning steps: %@. A card becomes Learned at the threshold, then decay removes repeats at the schedule above." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gut führt durch die Lernschritte: %@. Eine Karte gilt an der Schwelle als gelernt, danach entfernt der Verfall Wiederholungen nach dem Zeitplan oben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien avanza por los pasos de aprendizaje: %@. Una tarjeta se vuelve Aprendida al llegar al umbral y luego el deterioro elimina repeticiones según la programación anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien fait avancer dans les étapes d'apprentissage : %@. Une carte devient apprise au seuil, puis la dégradation retire des répétitions selon le calendrier ci-dessus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagus memajukan langkah belajar: %@. Kartu dianggap dikuasai pada ambang, lalu penurunan menghapus pengulangan sesuai jadwal di atas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bene fa avanzare nei passaggi di apprendimento: %@. Una carta diventa Imparata alla soglia, poi il decadimento rimuove ripetizioni secondo la pianificazione sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「良い」で学習ステップ%@を進みます。カードはしきい値で学習済みになり、その後は上記のスケジュールで繰り返しが減少します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋아요는 학습 단계 %@를 진행합니다. 카드는 기준에 도달하면 학습 완료가 되고, 이후 위 일정에 따라 반복 횟수가 줄어듭니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goed doorloopt de leerstappen: %@. Een kaart wordt Geleerd bij de drempel, daarna verwijdert verval herhalingen volgens het schema hierboven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrze przechodzi przez etapy nauki: %@. Karta zostaje opanowana po osiągnięciu progu, a następnie wygaszanie usuwa powtórki zgodnie z powyższym harmonogramem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bom avança pelas etapas de aprendizado: %@. Um cartão se torna aprendido no limite e, depois, o decaimento remove repetições conforme a programação acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Хорошо» продвигает по этапам изучения: %@. Карточка становится выученной при достижении порога, затем затухание убирает повторы по расписанию выше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İyi, öğrenme adımlarından geçirir: %@. Kart eşikte Öğrenildi olur, ardından azalma yukarıdaki zamanlamaya göre tekrarları kaldırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Добре» просуває етапами вивчення: %@. Картка стає вивченою після досягнення порогу, далі затухання прибирає повтори за розкладом вище."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tốt sẽ đi qua các bước học: %@. Thẻ trở thành Đã học khi đạt ngưỡng, sau đó suy giảm sẽ giảm số lần lặp theo lịch trình ở trên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“良好”会依次推进学习步骤：%@。卡片达到阈值后变为已学会，随后衰减会按上述时间表移除重复次数。"
          }
        }
      }
    },
