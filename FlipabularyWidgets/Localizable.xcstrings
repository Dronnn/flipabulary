        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maandeinden en zomertijd worden volgens je lokale kalender berekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejścia na koniec miesiąca i zmiany czasu letniego są liczone według lokalnego kalendarza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
