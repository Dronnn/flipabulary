        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復習した回答は保持されます。評価していないカードだけが破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복습한 답변은 유지됩니다. 평가하지 않은 카드만 버려집니다."
