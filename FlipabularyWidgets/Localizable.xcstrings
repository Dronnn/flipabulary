    "Word sets are shared: editing a set updates every widget that uses it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wörtersets werden geteilt: Wenn du ein Set bearbeitest, werden alle Widgets aktualisiert, die es verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los conjuntos de palabras se comparten: si editas uno, se actualizan todos los widgets que lo usan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ensembles de mots sont partagés : modifier un ensemble met à jour tous les widgets qui l'utilisent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set kata dibagikan: mengedit satu set akan memperbarui setiap widget yang menggunakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I set di parole sono condivisi: modificare un set aggiorna tutti i widget che lo usano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語セットは共有されます。セットを編集すると、それを使うすべてのウィジェットが更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단어 세트는 공유됩니다. 세트를 편집하면 해당 세트를 사용하는 모든 위젯이 업데이트됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woordensets worden gedeeld: als je een set bewerkt, worden alle widgets die deze gebruiken bijgewerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbiory słów są wspólne: edycja zbioru aktualizuje wszystkie widgety, które go używają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os conjuntos de palavras são compartilhados: editar um conjunto atualiza todos os widgets que o usam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подборки слов общие: изменение подборки обновляет все виджеты, которые её используют."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelime setleri paylaşılır: bir seti düzenlemek, onu kullanan tüm widget’ları günceller."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добірки слів спільні: редагування добірки оновлює всі віджети, які її використовують."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bộ từ được chia sẻ: khi sửa một bộ, mọi tiện ích dùng bộ đó sẽ được cập nhật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单词集是共享的：编辑单词集会更新使用它的每个小组件。"
          }
        }
      }
    },
