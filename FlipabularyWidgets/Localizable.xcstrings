          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Денний ліміт нових карток вичерпано. Решта нових карток залишається у вашій бібліотеці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã đạt giới hạn thẻ mới hôm nay. Các thẻ mới còn lại vẫn trong thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
