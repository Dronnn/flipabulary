    "Month-end and daylight-saving changes use your local calendar." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monatsenden und Zeitumstellungen folgen deinem lokalen Kalender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios de fin de mes y de horario de verano usan tu calendario local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les changements de fin de mois et d'heure d'été suivent votre calendrier local."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan akhir bulan dan waktu musim panas mengikuti kalender lokal Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fine mese e cambi di ora legale usano il tuo calendario locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月末や夏時間の変更は現地のカレンダーに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월말과 서머타임 변경은 현지 캘린더를 따릅니다."
