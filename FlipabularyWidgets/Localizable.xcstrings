    "Shared across every session in this stack." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für alle Sitzungen in diesem Stapel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartido en todas las sesiones de este mazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagé entre toutes les sessions de ce paquet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berlaku di setiap sesi dalam tumpukan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condiviso tra tutte le sessioni di questo mazzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスタックのすべてのセッションで共有されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스택의 모든 세션에 공통으로 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedeeld door elke sessie in deze stapel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wspólne dla każdej sesji w tym zestawie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhado entre todas as sessões deste baralho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общее для всех сеансов в этом наборе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu destedeki her oturumda geçerli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спільне для всіх сеансів у цьому наборі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng chung cho mọi phiên trong bộ thẻ này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此单词本中的每次学习共用。"
          }
        }
      }
    },
    "Short steps bring new and relearning cards back quickly. Each step must be positive, unique, and longer than the one before it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurze Schritte bringen neue Karten und Wiederholungskarten schnell zurück. Jeder Schritt muss positiv, eindeutig und länger als der vorherige sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pasos cortos hacen que las tarjetas nuevas y de reaprendizaje vuelvan pronto. Cada paso debe ser positivo, único y más largo que el anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des étapes courtes ramènent rapidement les cartes nouvelles et en réapprentissage. Chaque étape doit être positive, unique et plus longue que la précédente."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah pendek membuat kartu baru dan yang dipelajari ulang kembali lebih cepat. Setiap langkah harus positif, unik, dan lebih panjang dari langkah sebelumnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passaggi brevi riportano rapidamente le carte nuove e in riapprendimento. Ogni passaggio deve essere positivo, unico e più lungo del precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短いステップは新規カードと再学習カードをすぐに戻します。各ステップは正の値で、重複せず、前のステップより長くする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧은 단계는 새 카드와 재학습 카드를 빠르게 다시 불러옵니다. 각 단계는 양수여야 하며, 중복되지 않고 앞 단계보다 길어야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korte stappen brengen nieuwe en herlerende kaarten snel terug. Elke stap moet positief, uniek en langer dan de vorige zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krótkie etapy szybko przywracają nowe karty i karty do ponownej nauki. Każdy etap musi być dodatni, unikalny i dłuższy od poprzedniego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etapas curtas trazem rapidamente de volta os cartões novos e os de reaprendizado. Cada etapa deve ser positiva, única e maior que a anterior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткие шаги быстро возвращают новые карточки и карточки на переучивание. Каждый шаг должен быть положительным, уникальным и длиннее предыдущего."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısa adımlar yeni ve yeniden öğrenilen kartları hızla geri getirir. Her adım pozitif, benzersiz ve bir öncekinden uzun olmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткі кроки швидко повертають нові картки й картки на переучування. Кожен крок має бути додатним, унікальним і довшим за попередній."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bước ngắn giúp thẻ mới và thẻ đang học lại quay lại nhanh. Mỗi bước phải dương, duy nhất và dài hơn bước trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较短的步骤能让新卡片和重新学习的卡片快速回来。每个步骤必须为正数、唯一，并且比前一步更长。"
          }
        }
      }
    },
    "Show a stack or your own word set. Add multiple widgets for different sets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeige einen Stapel oder dein eigenes Wörterset. Füge mehrere Widgets für verschiedene Sets hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un mazo o tu propio conjunto de palabras. Añade varios widgets para distintos conjuntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez un paquet ou votre propre ensemble de mots. Ajoutez plusieurs widgets pour différents ensembles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan tumpukan atau set kata Anda sendiri. Tambahkan beberapa widget untuk set yang berbeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un mazzo o il tuo set di parole. Aggiungi più widget per set diversi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スタックまたは自分の単語セットを表示します。セットごとにウィジェットを複数追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스택 또는 나만의 단어 세트를 표시하십시오. 세트마다 위젯을 여러 개 추가할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon een stapel of je eigen woordenset. Voeg meerdere widgets toe voor verschillende sets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj zestaw lub własny zbiór słów. Dodaj wiele widgetów dla różnych zbiorów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre um baralho ou seu próprio conjunto de palavras. Adicione vários widgets para conjuntos diferentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажите набор или свою подборку слов. Добавьте несколько виджетов для разных подборок."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir deste veya kendi kelime setinizi gösterin. Farklı setler için birden fazla widget ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажіть набір або власну добірку слів. Додайте кілька віджетів для різних добірок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị bộ thẻ hoặc bộ từ của riêng bạn. Thêm nhiều tiện ích cho các bộ từ khác nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示单词本或你自己的单词集。为不同的单词集添加多个小组件。"
          }
        }
      }
    },
