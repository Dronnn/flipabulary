    "Completed answers are saved. Unfinished cards stay in your library." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgeschlossene Antworten werden gespeichert. Unfertige Karten bleiben in deiner Bibliothek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas completadas se guardan. Las tarjetas sin terminar se quedan en tu biblioteca."
