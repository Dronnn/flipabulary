          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipabulary nie może otworzyć lokalnej biblioteki. Uruchom aplikację ponownie po zwolnieniu miejsca."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipabulary yerel kitaplığını açamadı. Biraz depolama alanı boşaltıktan sonra uygulamayı yeniden başlat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flipabulary không thể mở thư viện cục bộ. Hãy khởi động lại ứng dụng sau khi giải phóng dung lượng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
