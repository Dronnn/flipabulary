    "Reviewed answers are kept. Only the ungraded card is discarded." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewertete Antworten bleiben erhalten. Nur die unbewertete Karte wird verworfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conservan las respuestas valoradas. Solo se descarta la tarjeta sin valorar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses révisées sont conservées. Seule la carte non évaluée est abandonnée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaban yang sudah ditinjau tetap disimpan. Hanya kartu yang belum dinilai yang dibuang."
