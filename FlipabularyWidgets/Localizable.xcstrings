    "Good answers needed before a word is Learned." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richtige Antworten nötig, bevor ein Wort als gelernt gilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesitan respuestas «Bien» para que una palabra se considere aprendida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonnes réponses nécessaires avant qu'un mot soit appris."
          }
        },
        "id" : {
          "stringUnit" : {
